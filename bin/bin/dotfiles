#!/usr/bin/env bash
set -euo pipefail

_script="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(dirname "$(dirname "$(dirname "$_script")")")"

declare -A _DOTFILES_LOADED_MODULES=()

_dotfiles_source_module() {
	local path="$1"
	[[ -z "${_DOTFILES_LOADED_MODULES[$path]+x}" ]] || return 0
	[[ -f "$path" ]] || {
		printf 'Error: required Dotfiles module is missing: %s\n' "$path" >&2
		return 1
	}
	# shellcheck source=/dev/null
	source "$path"
	_DOTFILES_LOADED_MODULES["$path"]=1
}

_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/shared/py_service.sh"
_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/shared/tui/report_table.sh"
_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/command_metadata.sh"

_dotfiles_use_color() {
	[[ -n "${NO_COLOR:-}" ]] && return 1
	[[ -n "${FORCE_COLOR:-}" ]] && return 0
	[[ -t 1 ]] && return 0
	# install.sh tees stdout to a log; stdin stays on the real terminal.
	[[ -t 0 ]] && return 0
	return 1
}

if _dotfiles_use_color; then
	colors_set_palette
else
	colors_clear_palette
fi

NOT_INSTALLED='not installed'

# --- Helpers ---
# Two spaces, the same left edge the headers, tables and step lines use, so one
# screen reads as one document.
_msg() { printf '  %s\n' "$*"; }
_warn() { printf '  %s%s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
_err() { printf '  %s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }

_dotfiles_load_status_modules() {
	local path
	for path in \
		"${DOTFILES_DIR}/scripts/lib/shared/tui/tty.sh" \
		"${DOTFILES_DIR}/scripts/lib/parallel_probe.sh" \
		"${DOTFILES_DIR}/scripts/lib/tool_resolve.sh" \
		"${DOTFILES_DIR}/scripts/lib/managed_tool_state.sh" \
		"${DOTFILES_DIR}/scripts/lib/package_metadata.sh" \
		"${DOTFILES_DIR}/scripts/lib/components/registry.sh" \
		"${DOTFILES_DIR}/scripts/lib/wsl_conf.sh" \
		"${DOTFILES_DIR}/scripts/lib/components/probes.sh"; do
		_dotfiles_source_module "$path" || return 1
	done
}

_dotfiles_load_update_modules() {
	local path
	_dotfiles_load_status_modules || return 1
	for path in \
		"${DOTFILES_DIR}/scripts/lib/shared/sudo_prime.sh" \
		"${DOTFILES_DIR}/scripts/lib/arch.sh" \
		"${DOTFILES_DIR}/scripts/lib/repo_update.sh" \
		"${DOTFILES_DIR}/scripts/lib/github_token.sh" \
		"${DOTFILES_DIR}/scripts/lib/github_api.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/logging.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/remote_script.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/github_release.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/fonts.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/apt.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/cli_tools.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/graphify.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/boost.sh" \
		"${DOTFILES_DIR}/scripts/lib/action_log.sh" \
		"${DOTFILES_DIR}/scripts/lib/update_components.sh" \
		"${DOTFILES_DIR}/scripts/lib/update_workflow.sh"; do
		_dotfiles_source_module "$path" || return 1
	done
}

dotfiles_load_command() {
	case "$1" in
	status | doctor) _dotfiles_load_status_modules ;;
	packages)
		_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/package_metadata.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/menus/package_lib.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/components/registry.sh"
		;;
	update) _dotfiles_load_update_modules ;;
	full-update)
		# full-update installs as well as updates (roadmap item 2). The installer
		# and component families come in through their own loaders: a list
		# written file by file already missed PKG_FILE, run_docker and
		# menu_tty_cols, and the apt components then installed nothing while
		# their probes still reported "installed".
		#
		# Deliberately not scripts/lib/load.sh: that installs a colour palette
		# and the menu stack into a command that has never had either, and
		# print_report_table reads the palette without honouring NO_COLOR.
		_dotfiles_load_update_modules &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/bootstrap.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/docker.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/shared/tui/menu_render.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/installers/load.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/components/load.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/full_update.sh"
		;;
	*) return 0 ;;
	esac
}

# ADR-0001: the report layout lives in Python now
# (scripts/lib/shared/python/). Width and colour stay here, because the Bash
# side already owns those predicates and duplicating them is the divergence the
# consolidation exists to remove -- they are passed as arguments instead.
#
# Falls back to the Bash renderer when python3 is unavailable, so a checkout
# that has not installed the runtime yet still prints its own status.
_dotfiles_render_report() {
	local title="$1" breadcrumb="$2" rows_name="$3"
	local -n _rows_ref="$rows_name"
	local row component detail result
	local ok_count=0 check_count=0 miss_count=0

	# Counts are optional: pass them when the caller already knows them, as
	# Doctor does, and let the renderer derive them otherwise.
	local want_ok="${4:-}" want_check="${5:-}" want_miss="${6:-}"

	if py_service_available; then
		local -a args=(--cols "$(rt_report_columns)" --rollup)
		[[ -n "$title" ]] && args+=(--title "$title")
		[[ -n "$breadcrumb" ]] && args+=(--breadcrumb "$breadcrumb")
		[[ -n "$want_ok" ]] && args+=(--ok "$want_ok")
		[[ -n "$want_check" ]] && args+=(--check "$want_check")
		[[ -n "$want_miss" ]] && args+=(--miss "$want_miss")
		_rt_ensure_colors
		[[ -n "${C_RESET:-}" ]] && args+=(--color)
		# Process substitution rather than a pipeline: bash closes coprocess
		# descriptors in pipeline children. See scripts/lib/shared/py_service.sh.
		if py_service_call render "${args[@]}" < <(printf '%s\n' "${_rows_ref[@]}"); then
			return 0
		fi
	fi

	[[ -n "$title" ]] && rt_print_header "$title" "$breadcrumb"
	rt_print_table_columns
	for row in "${_rows_ref[@]}"; do
		IFS='|' read -r component detail result <<<"$row"
		# The shared vocabulary, not a second list: this counter knew only
		# `installed` and `configured`, so the repository row's `ok` was drawn
		# green and counted as needing attention in the same table.
		case "$(status_result_class "$result")" in
		ok) ((++ok_count)) ;;
		miss) ((++miss_count)) ;;
		*) ((++check_count)) ;;
		esac
		rt_print_table_row "$component" "$detail" "$result"
	done
	rt_print_rollup "${want_ok:-$ok_count}" "${want_check:-$check_count}" "${want_miss:-$miss_count}"
}

# Whether this checkout has updates waiting. Bounded, and degrades to
# "unchecked" rather than hanging a status on a slow or absent network.
_dotfiles_append_repo_row() {
	local rows_name="$1"
	local -n _rows="$rows_name"
	local row=''

	# Started before the substitution below, not inside it: a coprocess belongs
	# to the shell that starts it.
	if py_service_available; then
		# `|| true`: a row that cannot be produced must never fail the whole
		# status. Without it the assignment's non-zero exit propagated under
		# `set -e` and a reporting command started exiting non-zero.
		row="$(py_service_call repo_status "$DOTFILES_DIR" 'Dotfiles repo' \
			"${DOTFILES_REPO_CHECK_TIMEOUT:-5}" </dev/null || true)"
	fi
	# No python3 yet is a normal state during first setup, not an error.
	[[ -n "$row" ]] || row='Dotfiles repo|unchecked (python3 unavailable)|skipped'
	_rows+=("$row")
}

cmd_status() {
	local row component detail result
	local -a rows=()
	local ok_count=0 check_count=0 miss_count=0
	collect_component_status_rows rows
	# The repository is a component of this machine's setup too, and its state
	# belongs in the table rather than in a raw `git status -sb` underneath it.
	_dotfiles_append_repo_row rows
	_dotfiles_render_report 'Check Status' 'Dotfiles › Check Status' rows

	# Local changes only. Remote freshness is answered by the Dotfiles repo row
	# in the table above, so repeating "unchecked" here would now contradict it.
	status_print_suggestions rows || true

	printf '\n'
	rt_print_section "Local changes"
	if command -v git >/dev/null 2>&1; then
		# Indented like the rest of the run: this is git's own text, and it
		# printed hard against the margin under an indented heading.
		git -C "$DOTFILES_DIR" status -sb | sed 's/^/    /'
	else
		_msg "git $NOT_INSTALLED"
	fi
}

# Doctor: only what needs attention, with the command that fixes it.
# Status answers "what is installed"; this answers "what is wrong".
# Kept as a command because its exit status is load-bearing: full-update's
# postflight uses it to choose between "completed" and "needs attention", and
# a script can gate on it. The report it used to print is Check Status's now --
# it was the same probes filtered down, and the suggestions that were the real
# content moved under that table.
cmd_doctor() {
	# shellcheck disable=SC2034  # Filled and read through namerefs.
	local -a rows=()
	collect_component_status_rows rows
	if status_print_suggestions rows; then
		printf '  %sNothing needs attention.%s\n' "${C_GREEN:-}" "${C_RESET:-}"
		return 0
	fi
	return 1
}

cmd_commands() {
	dotfiles_command_metadata_validate || {
		_err "Error: invalid command metadata."
		return 1
	}
	dotfiles_command_print_table
}

cmd_packages() {
	PKG_FILE="${DOTFILES_DIR}/packages/packages.txt"
	export PKG_FILE
	package_metadata_load "$PKG_FILE" || return 1
	package_lib_render_components 100
}

# The action log is retained (newest DOTFILES_LOG_RETAIN) but there was no way
# to find one except `ls log/`.
cmd_logs() {
	local mode="${1:---list}" log_dir="${DOTFILES_DIR}/log" newest
	local -a logs=()
	case "$mode" in
	--list | --last) ;;
	*)
		_err "Unknown logs option: $mode"
		_msg 'Usage: dotfiles logs [--list|--last]'
		return 64
		;;
	esac

	if [[ ! -d "$log_dir" ]]; then
		_msg 'No logs yet.'
		return 0
	fi
	mapfile -t logs < <(find "$log_dir" -maxdepth 1 -type f -name '*.log' -print | sort -r)
	if ((${#logs[@]} == 0)); then
		_msg 'No logs yet.'
		return 0
	fi

	if [[ "$mode" == --last ]]; then
		newest="${logs[0]}"
		printf '%s%s%s\n\n' "${C_DIM:-}" "$newest" "${C_RESET:-}"
		cat -- "$newest"
		return 0
	fi

	rt_print_header "Logs" "Dotfiles › Logs"
	local file
	for file in "${logs[@]}"; do
		printf '  %s  %s%s%s\n' "$(basename -- "$file")" \
			"${C_DIM:-}" "$(du -h -- "$file" | cut -f1)" "${C_RESET:-}"
	done
	printf '\n  %d log(s); newest first. Show the newest with: dotfiles logs --last\n' "${#logs[@]}"
}

cmd_restow() {
	if ! command -v stow >/dev/null 2>&1; then
		_err "Error: 'stow' is not installed."
		exit 1
	fi
	_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/installers/stow.sh" || exit 1
	remove_obsolete_claude_rc_link
	stow --dir "$DOTFILES_DIR" --target "$HOME" --restow bash bin readline
	_msg "Dotfiles restowed."
}

# shellcheck disable=SC2120  # Called indirectly through the command-handler map.
cmd_menu() {
	local installer="${DOTFILES_DIR}/install.sh"
	if [[ ! -f "$installer" ]]; then
		_err "Error: install.sh not found at ${installer}"
		exit 1
	fi
	exec bash "$installer" "$@"
}

removed_command_guidance() {
	case "$1" in
	summary) _err 'Command removed; use dotfiles status.' ;;
	upgrade) _err 'Command removed; use dotfiles update [--all].' ;;
	self) _err 'Command removed; use dotfiles update (or dotfiles restow for link-only work).' ;;
	*) return 1 ;;
	esac
	return 0
}

cmd_help() {
	cat <<EOF
  Usage: dotfiles <command> [options]

  Commands:
EOF
	dotfiles_command_print_table
	printf '\n  Repo: %s\n' "$DOTFILES_DIR"
}

main() {
	local command="${1:-}" handler
	case "$command" in
	-h | --help) command=help ;;
	'')
		if [[ -t 1 ]]; then
			cmd_menu "$@"
		else
			cmd_help
		fi
		return
		;;
	esac

	handler="${DOTFILES_COMMAND_HANDLERS[$command]:-}"
	if [[ -n "$handler" ]]; then
		shift
		dotfiles_load_command "$command" || return 1
		"$handler" "$@"
	else
		if removed_command_guidance "$command"; then exit 1; fi
		_err "Unknown command: $command"
		_msg ""
		cmd_help
		exit 1
	fi
}

if [[ "${DOTFILES_SOURCE_ONLY:-0}" != 1 ]]; then
	main "$@"
fi
