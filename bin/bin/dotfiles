#!/usr/bin/env bash
set -euo pipefail

_script="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(dirname "$(dirname "$(dirname "$_script")")")"

declare -A _DOTFILES_LOADED_MODULES=()

_dotfiles_source_module() {
	local path="$1"
	[[ -z "${_DOTFILES_LOADED_MODULES[$path]+x}" ]] || return 0
	[[ -f "$path" ]] || {
		printf 'Error: required Dotfiles module is missing: %s\n' "$path" >&2
		return 1
	}
	# shellcheck source=/dev/null
	source "$path"
	_DOTFILES_LOADED_MODULES["$path"]=1
}

_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/shared/tui/report_table.sh"
_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/command_metadata.sh"

_dotfiles_use_color() {
	[[ -n "${NO_COLOR:-}" ]] && return 1
	[[ -n "${FORCE_COLOR:-}" ]] && return 0
	[[ -t 1 ]] && return 0
	# install.sh tees stdout to a log; stdin stays on the real terminal.
	[[ -t 0 ]] && return 0
	return 1
}

if _dotfiles_use_color; then
	colors_set_palette
else
	colors_clear_palette
fi

NOT_INSTALLED='not installed'

# --- Helpers ---
_msg() { printf '%s\n' "$*"; }
_warn() { printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
_err() { printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }

_dotfiles_load_status_modules() {
	local path
	for path in \
		"${DOTFILES_DIR}/scripts/lib/parallel_probe.sh" \
		"${DOTFILES_DIR}/scripts/lib/tool_resolve.sh" \
		"${DOTFILES_DIR}/scripts/lib/managed_tool_state.sh" \
		"${DOTFILES_DIR}/scripts/lib/package_metadata.sh" \
		"${DOTFILES_DIR}/scripts/lib/components/registry.sh" \
		"${DOTFILES_DIR}/scripts/lib/wsl_conf.sh" \
		"${DOTFILES_DIR}/scripts/lib/components/probes.sh"; do
		_dotfiles_source_module "$path" || return 1
	done
}

_dotfiles_load_update_modules() {
	local path
	_dotfiles_load_status_modules || return 1
	for path in \
		"${DOTFILES_DIR}/scripts/lib/arch.sh" \
		"${DOTFILES_DIR}/scripts/lib/repo_update.sh" \
		"${DOTFILES_DIR}/scripts/lib/github_token.sh" \
		"${DOTFILES_DIR}/scripts/lib/github_api.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/logging.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/remote_script.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/github_release.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/fonts.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/apt.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/cli_tools.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/graphify.sh" \
		"${DOTFILES_DIR}/scripts/lib/installers/boost.sh" \
		"${DOTFILES_DIR}/scripts/lib/action_log.sh" \
		"${DOTFILES_DIR}/scripts/lib/update_components.sh" \
		"${DOTFILES_DIR}/scripts/lib/update_workflow.sh"; do
		_dotfiles_source_module "$path" || return 1
	done
}

dotfiles_load_command() {
	case "$1" in
	status | doctor) _dotfiles_load_status_modules ;;
	packages)
		_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/package_metadata.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/menus/package_lib.sh" &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/components/registry.sh"
		;;
	update) _dotfiles_load_update_modules ;;
	full-update)
		_dotfiles_load_update_modules &&
			_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/full_update.sh"
		;;
	*) return 0 ;;
	esac
}

cmd_status() {
	local row component detail result
	local -a rows=()
	local ok_count=0 check_count=0 miss_count=0
	collect_component_status_rows rows
	rt_print_header "Check Status" "Dotfiles › Check Status"
	rt_print_table_columns
	for row in "${rows[@]}"; do
		IFS='|' read -r component detail result <<<"$row"
		case "$result" in
		installed | configured) ((++ok_count)) ;;
		missing) ((++miss_count)) ;;
		*) ((++check_count)) ;;
		esac
		rt_print_table_row "$component" "$detail" "$result"
	done
	rt_print_rollup "$ok_count" "$check_count" "$miss_count"

	printf '\n'
	rt_print_section "Repository"
	if command -v git >/dev/null 2>&1; then
		git -C "$DOTFILES_DIR" status -sb
		_msg "Remote freshness: unchecked (run dotfiles update)"
	else
		_msg "git $NOT_INSTALLED"
		_msg "Remote freshness: unchecked"
	fi
}

# Doctor: only what needs attention, with the command that fixes it.
# Status answers "what is installed"; this answers "what is wrong".
cmd_doctor() {
	local row component detail result codex_path
	local codex_missing=0 codex_conflict=0
	local -a rows=() problems=()
	collect_component_status_rows rows
	for row in "${rows[@]}"; do
		IFS='|' read -r component detail result <<<"$row"
		case "$result" in
		installed | configured | skipped) ;;
		*) problems+=("$row") ;;
		esac
	done

	rt_print_header "Doctor" "Dotfiles › Doctor"
	if ((${#problems[@]} == 0)); then
		rt_print_table_columns
		rt_print_table_row "All components" "installed or configured" "ok"
		rt_print_rollup 1 0 0
		printf '\n%sNothing needs attention.%s\n' "${C_GREEN:-}" "${C_RESET:-}"
		return 0
	fi

	rt_print_table_columns
	local miss_count=0 check_count=0
	for row in "${problems[@]}"; do
		IFS='|' read -r component detail result <<<"$row"
		if [[ "$component" == 'Codex CLI' ]]; then
			if [[ "$result" == missing ]]; then
				codex_missing=1
			elif [[ "$detail" == *'(external; migration required)'* || "$detail" == *'shadowed by'* ]]; then
				codex_conflict=1
			fi
		fi
		case "$result" in
		missing) ((++miss_count)) ;;
		*) ((++check_count)) ;;
		esac
		rt_print_table_row "$component" "$detail" "$result"
	done
	rt_print_rollup 0 "$check_count" "$miss_count"

	printf '\n'
	rt_print_section "Suggested"
	((codex_missing > 0)) && _msg "  Run initial setup and select Codex CLI:  dotfiles menu"
	if ((codex_conflict > 0)); then
		codex_path="$(codex_active_command 2>/dev/null || true)"
		_msg "  Resolve the conflicting Codex command:  ${codex_path:-unknown}"
		_msg "  See README.md#codex-cli-migration."
	fi
	((miss_count > 0)) && _msg "  Install what is missing:  dotfiles menu  (Install Dotfiles)"
	((check_count > 0)) && _msg "  Re-check after updating:  dotfiles update"
	_msg "  Repair stow links only:   dotfiles restow"
	return 1
}

cmd_commands() {
	dotfiles_command_metadata_validate || {
		_err "Error: invalid command metadata."
		return 1
	}
	dotfiles_command_print_table
}

cmd_packages() {
	PKG_FILE="${DOTFILES_DIR}/packages/packages.txt"
	export PKG_FILE
	package_metadata_load "$PKG_FILE" || return 1
	package_lib_render_components 100
}

# The action log is retained (newest DOTFILES_LOG_RETAIN) but there was no way
# to find one except `ls log/`.
cmd_logs() {
	local mode="${1:---list}" log_dir="${DOTFILES_DIR}/log" newest
	local -a logs=()
	case "$mode" in
	--list | --last) ;;
	*)
		_err "Unknown logs option: $mode"
		_msg 'Usage: dotfiles logs [--list|--last]'
		return 64
		;;
	esac

	if [[ ! -d "$log_dir" ]]; then
		_msg 'No logs yet.'
		return 0
	fi
	mapfile -t logs < <(find "$log_dir" -maxdepth 1 -type f -name '*.log' -print | sort -r)
	if ((${#logs[@]} == 0)); then
		_msg 'No logs yet.'
		return 0
	fi

	if [[ "$mode" == --last ]]; then
		newest="${logs[0]}"
		printf '%s%s%s\n\n' "${C_DIM:-}" "$newest" "${C_RESET:-}"
		cat -- "$newest"
		return 0
	fi

	rt_print_header "Logs" "Dotfiles › Logs"
	local file
	for file in "${logs[@]}"; do
		printf '  %s  %s%s%s\n' "$(basename -- "$file")" \
			"${C_DIM:-}" "$(du -h -- "$file" | cut -f1)" "${C_RESET:-}"
	done
	printf '\n  %d log(s); newest first. Show the newest with: dotfiles logs --last\n' "${#logs[@]}"
}

cmd_restow() {
	if ! command -v stow >/dev/null 2>&1; then
		_err "Error: 'stow' is not installed."
		exit 1
	fi
	_dotfiles_source_module "${DOTFILES_DIR}/scripts/lib/installers/stow.sh" || exit 1
	remove_obsolete_claude_rc_link
	stow --dir "$DOTFILES_DIR" --target "$HOME" --restow bash bin readline
	_msg "Dotfiles restowed."
}

# shellcheck disable=SC2120  # Called indirectly through the command-handler map.
cmd_menu() {
	local installer="${DOTFILES_DIR}/install.sh"
	if [[ ! -f "$installer" ]]; then
		_err "Error: install.sh not found at ${installer}"
		exit 1
	fi
	exec bash "$installer" "$@"
}

removed_command_guidance() {
	case "$1" in
	summary) _err 'Command removed; use dotfiles status.' ;;
	upgrade) _err 'Command removed; use dotfiles update [--all].' ;;
	self) _err 'Command removed; use dotfiles update (or dotfiles restow for link-only work).' ;;
	*) return 1 ;;
	esac
	return 0
}

cmd_help() {
	cat <<EOF
Usage: dotfiles <command> [options]

Commands:
EOF
	dotfiles_command_print_table
	printf '\nRepo: %s\n' "$DOTFILES_DIR"
}

main() {
	local command="${1:-}" handler
	case "$command" in
	-h | --help) command=help ;;
	'')
		if [[ -t 1 ]]; then
			cmd_menu "$@"
		else
			cmd_help
		fi
		return
		;;
	esac

	handler="${DOTFILES_COMMAND_HANDLERS[$command]:-}"
	if [[ -n "$handler" ]]; then
		shift
		dotfiles_load_command "$command" || return 1
		"$handler" "$@"
	else
		if removed_command_guidance "$command"; then exit 1; fi
		_err "Unknown command: $command"
		_msg ""
		cmd_help
		exit 1
	fi
}

if [[ "${DOTFILES_SOURCE_ONLY:-0}" != 1 ]]; then
	main "$@"
fi
