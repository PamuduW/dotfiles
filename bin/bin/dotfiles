#!/usr/bin/env bash
set -euo pipefail

_script="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(dirname "$(dirname "$(dirname "$_script")")")"

_REPORT_TABLE_LIB="${DOTFILES_DIR}/scripts/lib/report_table.sh"
if [[ -f "$_REPORT_TABLE_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_REPORT_TABLE_LIB"
fi

_COMMAND_METADATA_LIB="${DOTFILES_DIR}/scripts/lib/command_metadata.sh"
if [[ -f "$_COMMAND_METADATA_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_COMMAND_METADATA_LIB"
fi

_COMPONENT_REGISTRY_LIB="${DOTFILES_DIR}/scripts/lib/components/registry.sh"
_PACKAGE_LIB="${DOTFILES_DIR}/scripts/menus/package_lib.sh"
if [[ -f "$_COMPONENT_REGISTRY_LIB" && -f "$_PACKAGE_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_COMPONENT_REGISTRY_LIB"
	# shellcheck source=/dev/null
	source "$_PACKAGE_LIB"
fi

_GRAPHIFY_INSTALLER_LIB="${DOTFILES_DIR}/scripts/lib/installers/graphify.sh"
if [[ -f "$_GRAPHIFY_INSTALLER_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_GRAPHIFY_INSTALLER_LIB"
fi

_ARCH_LIB="${DOTFILES_DIR}/scripts/lib/arch.sh"
if [[ -f "$_ARCH_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_ARCH_LIB"
fi

_REPO_UPDATE_LIB="${DOTFILES_DIR}/scripts/lib/repo_update.sh"
if [[ -f "$_REPO_UPDATE_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_REPO_UPDATE_LIB"
fi

_GITHUB_TOKEN_LIB="${DOTFILES_DIR}/scripts/lib/github_token.sh"
if [[ -f "$_GITHUB_TOKEN_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_GITHUB_TOKEN_LIB"
fi

_GITHUB_API_LIB="${DOTFILES_DIR}/scripts/lib/github_api.sh"
if [[ -f "$_GITHUB_API_LIB" ]]; then
	# shellcheck source=/dev/null
	source "$_GITHUB_API_LIB"
fi

# --- TTY colors ---
_dotfiles_use_color() {
	[[ -n "${NO_COLOR:-}" ]] && return 1
	[[ -n "${FORCE_COLOR:-}" ]] && return 0
	[[ -t 1 ]] && return 0
	# install.sh tees stdout to a log; stdin stays on the real terminal.
	[[ -t 0 ]] && return 0
	return 1
}

if _dotfiles_use_color; then
	C_RESET=$'\033[0m'
	C_BOLD=$'\033[1m'
	C_DIM=$'\033[2m'
	C_GREEN=$'\033[32m'
	C_YELLOW=$'\033[33m'
	C_CYAN=$'\033[36m'
	C_ORANGE=$'\033[38;5;208m'
	C_RED=$'\033[31m'
else
	C_RESET=''
	C_BOLD=''
	C_DIM=''
	C_GREEN=''
	C_YELLOW=''
	C_CYAN=''
	C_ORANGE=''
	C_RED=''
fi

NOT_INSTALLED='not installed'

# --- Helpers ---
_msg() { printf '%s\n' "$*"; }
_warn() { printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
_err() { printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }

_INSTALLER_LOGGING_LIB="${DOTFILES_DIR}/scripts/lib/installers/logging.sh"
_REMOTE_SCRIPT_LIB="${DOTFILES_DIR}/scripts/lib/installers/remote_script.sh"
_GITHUB_RELEASE_LIB="${DOTFILES_DIR}/scripts/lib/installers/github_release.sh"
_FONT_INSTALLER_LIB="${DOTFILES_DIR}/scripts/lib/installers/fonts.sh"
# shellcheck source=scripts/lib/installers/logging.sh
source "$_INSTALLER_LOGGING_LIB"
# shellcheck source=scripts/lib/installers/remote_script.sh
source "$_REMOTE_SCRIPT_LIB"
# shellcheck source=scripts/lib/installers/github_release.sh
source "$_GITHUB_RELEASE_LIB"
# shellcheck source=scripts/lib/installers/fonts.sh
source "$_FONT_INSTALLER_LIB"

_APT_INSTALLER_LIB="${DOTFILES_DIR}/scripts/lib/installers/apt.sh"
_WSL_CONF_LIB="${DOTFILES_DIR}/scripts/lib/wsl_conf.sh"
_COMPONENT_PROBES_LIB="${DOTFILES_DIR}/scripts/lib/components/probes.sh"
# shellcheck source=scripts/lib/installers/apt.sh
source "$_APT_INSTALLER_LIB"
# shellcheck source=scripts/lib/wsl_conf.sh
source "$_WSL_CONF_LIB"
# shellcheck source=scripts/lib/components/probes.sh
source "$_COMPONENT_PROBES_LIB"

_UPDATE_COMPONENTS_LIB="${DOTFILES_DIR}/scripts/lib/update_components.sh"
_UPDATE_WORKFLOW_LIB="${DOTFILES_DIR}/scripts/lib/update_workflow.sh"
_FULL_UPDATE_LIB="${DOTFILES_DIR}/scripts/lib/full_update.sh"
# shellcheck source=scripts/lib/update_components.sh
source "$_UPDATE_COMPONENTS_LIB"
# shellcheck source=scripts/lib/update_workflow.sh
source "$_UPDATE_WORKFLOW_LIB"
# shellcheck source=scripts/lib/full_update.sh
source "$_FULL_UPDATE_LIB"

cmd_status() {
	local row component detail result
	local -a rows=()
	local ok_count=0 check_count=0 miss_count=0
	collect_component_status_rows rows
	rt_print_header "Check Status" "Dotfiles › Check Status"
	rt_print_table_columns
	for row in "${rows[@]}"; do
		IFS='|' read -r component detail result <<<"$row"
		case "$result" in
		installed | configured) ((++ok_count)) ;;
		missing) ((++miss_count)) ;;
		*) ((++check_count)) ;;
		esac
		rt_print_table_row "$component" "$detail" "$result"
	done
	rt_print_rollup "$ok_count" "$check_count" "$miss_count"

	printf '\n'
	rt_print_section "Repository"
	if command -v git >/dev/null 2>&1; then
		git -C "$DOTFILES_DIR" status -sb
		_msg "Remote freshness: unchecked (run dotfiles update)"
	else
		_msg "git $NOT_INSTALLED"
		_msg "Remote freshness: unchecked"
	fi
}

cmd_commands() {
	dotfiles_command_metadata_validate || {
		_err "Error: invalid command metadata."
		return 1
	}
	dotfiles_command_print_table
}

cmd_packages() {
	PKG_FILE="${DOTFILES_DIR}/packages/packages.txt"
	export PKG_FILE
	package_metadata_load "$PKG_FILE" || return 1
	package_lib_render_components 100
}

cmd_restow() {
	if ! command -v stow >/dev/null 2>&1; then
		_err "Error: 'stow' is not installed."
		exit 1
	fi
	stow --dir "$DOTFILES_DIR" --target "$HOME" --restow bash bin readline
	_msg "Dotfiles restowed."
}

# shellcheck disable=SC2120  # Called indirectly through the command-handler map.
cmd_menu() {
	local installer="${DOTFILES_DIR}/install.sh"
	if [[ ! -f "$installer" ]]; then
		_err "Error: install.sh not found at ${installer}"
		exit 1
	fi
	exec bash "$installer" "$@"
}

removed_command_guidance() {
	case "$1" in
	summary) _err 'Command removed; use dotfiles status.' ;;
	upgrade) _err 'Command removed; use dotfiles update [--all].' ;;
	self) _err 'Command removed; use dotfiles update (or dotfiles restow for link-only work).' ;;
	*) return 1 ;;
	esac
	return 0
}

cmd_help() {
	cat <<EOF
Usage: dotfiles <command> [options]

Commands:
EOF
	dotfiles_command_print_table
	printf '\nRepo: %s\n' "$DOTFILES_DIR"
}

main() {
	local command="${1:-}" handler
	case "$command" in
	-h | --help) command=help ;;
	'')
		if [[ -t 1 ]]; then
			cmd_menu "$@"
		else
			cmd_help
		fi
		return
		;;
	esac

	handler="${DOTFILES_COMMAND_HANDLERS[$command]:-}"
	if [[ -n "$handler" ]]; then
		shift
		"$handler" "$@"
	else
		if removed_command_guidance "$command"; then exit 1; fi
		_err "Unknown command: $command"
		_msg ""
		cmd_help
		exit 1
	fi
}

main "$@"
