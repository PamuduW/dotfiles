#!/usr/bin/env bash
set -euo pipefail

umask 077

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-rc"
pid_file="$state_dir/server.pid"
start_file="$state_dir/server.start"
cwd_file="$state_dir/server.cwd"
log_file="$state_dir/server.log"

usage() {
	printf 'Usage: claude-rc {start|stop}\n' >&2
}

process_identity() {
	local pid="$1" stat rest
	[[ -r "/proc/$pid/stat" ]] || return 1
	IFS= read -r stat <"/proc/$pid/stat" || return 1
	rest="${stat#*) }"
	[[ "$rest" != "$stat" ]] || return 1
	# After removing PID and command name, field 20 is the process start time.
	awk '{print $20}' <<<"$rest"
}

state_matches_process() {
	local pid recorded_start current_start
	[[ -f "$pid_file" && -f "$start_file" ]] || return 1
	IFS= read -r pid <"$pid_file" || return 1
	IFS= read -r recorded_start <"$start_file" || return 1
	[[ "$pid" =~ ^[0-9]+$ && "$recorded_start" =~ ^[0-9]+$ ]] || return 1
	current_start="$(process_identity "$pid")" || return 1
	[[ "$current_start" == "$recorded_start" ]]
}

start_server() {
	local claude_bin pid start_time project_dir
	mkdir -p -- "$state_dir"
	chmod 700 "$state_dir"

	if state_matches_process; then
		IFS= read -r pid <"$pid_file"
		printf 'Claude Remote Control is already running (PID %s).\n' "$pid"
		return 0
	fi
	rm -f -- "$pid_file" "$start_file" "$cwd_file"

	claude_bin="$(command -v claude 2>/dev/null)" || {
		printf "Error: 'claude' is not installed or not on PATH.\n" >&2
		return 127
	}
	project_dir="$(pwd -P)"
	nohup "$claude_bin" remote-control >"$log_file" 2>&1 </dev/null &
	pid=$!
	trap 'kill "$pid" 2>/dev/null || true' EXIT INT TERM
	sleep 0.2
	if ! kill -0 "$pid" 2>/dev/null; then
		wait "$pid" 2>/dev/null || true
		printf 'Error: Claude Remote Control exited during startup. See %s\n' "$log_file" >&2
		return 1
	fi
	start_time="$(process_identity "$pid")" || {
		printf 'Error: could not record the Claude Remote Control process.\n' >&2
		return 1
	}
	printf '%s\n' "$pid" >"$pid_file"
	printf '%s\n' "$start_time" >"$start_file"
	printf '%s\n' "$project_dir" >"$cwd_file"
	trap - EXIT INT TERM
	printf 'Claude Remote Control started (PID %s, directory %s).\n' "$pid" "$project_dir"
	printf 'Log: %s\n' "$log_file"
}

stop_server() {
	local pid
	if [[ ! -f "$pid_file" && ! -f "$start_file" ]]; then
		printf 'Claude Remote Control is not running.\n'
		return 0
	fi
	if ! state_matches_process; then
		printf 'Error: recorded Claude Remote Control state does not match the recorded process; refusing to stop it.\n' >&2
		return 1
	fi
	IFS= read -r pid <"$pid_file"
	kill "$pid"
	for _ in {1..50}; do
		state_matches_process || break
		sleep 0.1
	done
	if state_matches_process; then
		printf 'Error: Claude Remote Control did not stop after 5 seconds (PID %s).\n' "$pid" >&2
		return 1
	fi
	rm -f -- "$pid_file" "$start_file" "$cwd_file"
	printf 'Claude Remote Control stopped.\n'
}

if [[ $# -ne 1 ]]; then
	usage
	exit 64
fi

case "$1" in
start) start_server ;;
stop) stop_server ;;
*)
	usage
	exit 64
	;;
esac
